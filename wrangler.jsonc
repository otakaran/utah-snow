{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "utah-snow",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "send_metrics": false,
  "upload_source_maps": true,
  "routes": [{ "pattern": "utah.otakar.dev", "custom_domain": true }],
  // no assets.directory: the Cloudflare Vite plugin writes it into the generated build config
  "assets": { "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "triggers": { "crons": ["*/5 * * * *"] },
  "kv_namespaces": [{ "binding": "FRAMES", "id": "14f8e71c1041422d92652a35588b1578" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "utah-snow",
      "database_id": "ef0e1f48-6405-4f3c-b9e4-0b37c8780a76",
      "migrations_dir": "migrations"
    }
  ],
  // Scheduler: the DO alarm chain that ticks when cron triggers stall (src/worker/scheduler.ts). SQLite-backed (free plan).
  "durable_objects": { "bindings": [{ "name": "SCHEDULER", "class_name": "Scheduler" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Scheduler"] }],
  "observability": { "enabled": true }
}
