{
  "name": "utah-snow",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "check": "node scripts/check-repo.ts && biome check . && tsc -b && vitest run",
    "test": "vitest run",
    "e2e": "playwright test",
    "drift": "node scripts/drift-check.ts",
    "fixtures": "node scripts/refresh-fixtures.ts",
    "bench": "node scripts/bench-parsers.ts",
    "cf-typegen": "wrangler types -c wrangler.jsonc",
    "db:local": "wrangler d1 migrations apply DB --local -c wrangler.jsonc && wrangler d1 execute DB --local -c wrangler.jsonc --file e2e/seed.sql"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "hls.js": "1.7.3",
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@msw/cloudflare": "0.2.0",
    "@playwright/test": "1.64.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.2",
    "msw": "3.0.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.149.0"
  }
}
